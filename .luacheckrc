-- Luacheck: the addon's own list of the client's globals.
--
-- This runs against WoW Forever's beta interface, whose API surface does not
-- match the published WoW definition files, so `read_globals` is kept here
-- by hand: when luacheck reports an undefined global the client really has,
-- add it to the list. Everything else the client provides (frame methods,
-- fields of the C_* tables) is reached through these globals and needs no
-- entry. `luajit tests/run.lua`, not this, is the safety net for behaviour.

std = "lua51"
codes = true
max_line_length = false

-- The design tooling under .claude/ is not addon code.
exclude_files = { "%.claude/" }

ignore = {
    "212/self", -- the implicit self of a colon method, where the method does not use it
}

-- What the addon itself puts on _G: its SavedVariables, the slash command,
-- the bindings' names and entry points, and the frames it names (the client
-- makes a named frame a global). Settings and StaticPopupDialogs are the
-- client's, but tests replace or extend them.
globals = {
    "BINDING_HEADER_SOCIAL_DIARY",
    "BINDING_NAME_SOCIALDIARY_JOURNAL",
    "BINDING_NAME_SOCIALDIARY_REMEMBER",
    "Settings",
    "SLASH_SOCIALDIARY1",
    "SLASH_SOCIALDIARY2",
    "SlashCmdList",
    "SocialDiaryDB",
    "SocialDiaryCharDB",
    "SocialDiaryEntryFrame",
    "SocialDiaryIntroFrame",
    "SocialDiaryJournalFrame",
    "SocialDiaryPickerFrame",
    "SocialDiaryToastFrame",
    "SocialDiary_OnCompartmentClick",
    "SocialDiary_Remember",
    "SocialDiary_ToggleJournal",
    "StaticPopupDialogs",
    "UISpecialFrames",
}

-- The offline suite mocks the client, so it writes to the client's globals
-- and to tables the client owns (111, 112, 121, 122), and its fixtures
-- reuse short names section by section (4xx). The suite proves the tests
-- at runtime; everywhere else the rules stand as written.
files["tests/**"] = {
    ignore = { "111", "112", "121", "122", "411", "421", "431", "432" },
}

read_globals = {
    "C_AddOns",
    "CANCEL",
    "C_Container",
